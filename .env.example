# Restart Vite after changing these non-secret settings.
VITE_API_BASE_URL=http://localhost:8080
VITE_COURSE_CREATE_PATH=/api/admin/courses

# bearer: reuse the existing login token stored under this key.
# This file contains no JWT or secret key. Never put a secret in VITE_* values.
VITE_API_AUTH_MODE=bearer
VITE_AUTH_TOKEN_KEY=token

# If your backend sets an HttpOnly cookie, use VITE_API_AUTH_MODE=cookie.
# Cookie mode also needs Access-Control-Allow-Credentials on the backend.
